# Local validator (scripts/localnet.sh)
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_CLUSTER=localnet

# Devnet: replace the two lines above with
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# NEXT_PUBLIC_CLUSTER=devnet

# Accounts and workspaces (optional; without these, work stays in each browser).
# Added automatically by the Vercel Supabase integration; pull locally with `vercel env pull`.
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>
